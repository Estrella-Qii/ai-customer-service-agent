# LLM provider. SiliconFlow OpenAI-compatible endpoint is used by default.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Embedding provider. Do not use the chat model as the embedding model.
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# Optional. Leave 0 to auto-detect by calling the embedding API once.
# Set this when you know the exact vector dimension and want to avoid auto-detection.
EMBEDDING_DIMENSION=0

# Vector database.
# For Windows host FastAPI + Docker Qdrant, use 127.0.0.1, not the Docker service name qdrant.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=customer_service_docs

# RAG questions with no sources, low score, or "knowledge not found" answers are saved for governance.
GOVERNANCE_MIN_SOURCE_SCORE=0.45

# Conversation memory
REDIS_URL=redis://localhost:6379/0
MAX_HISTORY_MESSAGES=12
CONVERSATION_TTL_SECONDS=86400

# Request safety limits
MAX_UPLOAD_BYTES=10485760
MAX_QUESTION_CHARS=4000
